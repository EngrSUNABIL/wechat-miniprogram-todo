.empty {
  padding: 40rpx;
  text-align: center;
  color: #6b7280;
}

.order {
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.order-id {
  font-weight: 700;
  display: block;
}

.order-time {
  color: #6b7280;
  font-size: 24rpx;
}

.status {
  color: #2563eb;
  background: #dbeafe;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
}

.status.cancelled {
  color: #dc2626;
  background: #fee2e2;
}

.row {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  margin: 8rpx 0;
}

.details {
  margin-top: 10rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid #e5e7eb;
}

.cancel-btn {
  margin-top: 12rpx;
  background: #fee2e2;
  color: #dc2626;
  border-radius: 10rpx;
}
