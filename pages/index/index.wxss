.search-wrap {
  padding: 16rpx;
}

.search-input {
  height: 70rpx;
  background: #f3f4f6;
  border-radius: 12rpx;
  padding: 0 20rpx;
}

.category-scroll {
  margin-top: 20rpx;
  white-space: nowrap;
}

.category-list {
  display: inline-flex;
  gap: 12rpx;
}

.category-item {
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: #e5e7eb;
  color: #374151;
}

.category-item.active {
  background: #2563eb;
  color: #fff;
}

.cart-bar {
  margin: 20rpx 0;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: #dbeafe;
  color: #1d4ed8;
  font-weight: 600;
}

.loading {
  text-align: center;
  color: #6b7280;
  padding: 100rpx 0;
}

.product-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 16rpx 0;
}

.product-card {
  width: calc(50% - 8rpx);
  overflow: hidden;
}

.product-image {
  width: 100%;
  height: 220rpx;
}

.product-info {
  padding: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.product-name {
  font-size: 26rpx;
  min-height: 70rpx;
}

.product-rating {
  color: #f59e0b;
  font-size: 24rpx;
}

.add-btn {
  margin: 0 14rpx 14rpx;
  background: #2563eb;
  color: #fff;
  border-radius: 10rpx;
  font-size: 24rpx;
}
