/**pages/index/index.wxss**/
page {
  background-color: #f5f5f5;
}

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding: 0;
}

/* Header */
.header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  padding: 30rpx 20rpx;
  text-align: center;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.title {
  font-size: 36rpx;
  font-weight: bold;
}

/* Input Section */
.input-section {
  display: flex;
  gap: 10rpx;
  padding: 20rpx;
  background: white;
  border-bottom: 1rpx solid #eee;
}

.input-field {
  flex: 1;
  padding: 12rpx 16rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 14rpx;
}

.add-btn {
  padding: 0 20rpx;
  background-color: #667eea;
  color: white;
  border: none;
  border-radius: 8rpx;
  font-size: 14rpx;
  font-weight: bold;
  height: 44rpx;
  line-height: 44rpx;
}

.add-btn:active {
  background-color: #5568d3;
}

/* Empty State */
.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  padding: 40rpx;
}

.empty-text {
  color: #999;
  font-size: 16rpx;
  text-align: center;
}

/* Todo List */
.todo-list {
  flex: 1;
  padding: 20rpx;
  overflow-y: auto;
}

.todo-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: white;
  padding: 16rpx;
  margin-bottom: 12rpx;
  border-radius: 8rpx;
  box-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.05);
}

.todo-content {
  display: flex;
  align-items: center;
  flex: 1;
  gap: 12rpx;
}

.todo-checkbox {
  width: 24rpx;
  height: 24rpx;
}

.todo-text {
  font-size: 16rpx;
  color: #333;
  word-break: break-word;
  flex: 1;
}

.delete-btn {
  padding: 0 12rpx;
  margin-left: 10rpx;
  background-color: #ff6b6b;
  color: white;
  border: none;
  border-radius: 6rpx;
  font-size: 12rpx;
  height: 32rpx;
  line-height: 32rpx;
  min-width: 60rpx;
}

.delete-btn:active {
  background-color: #ff5252;
}

/* Stats */
.stats {
  padding: 16rpx 20rpx;
  background: white;
  border-top: 1rpx solid #eee;
  text-align: center;
}

.stats-text {
  font-size: 14rpx;
  color: #666;
}
