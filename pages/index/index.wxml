<view class="container">
  <view class="search-wrap card">
    <input class="search-input" placeholder="Search products" bindinput="onSearchInput" />
  </view>

  <scroll-view class="category-scroll" scroll-x="true" enable-flex="true">
    <view class="category-list">
      <view
        wx:for="{{categories}}"
        wx:key="*this"
        class="category-item {{activeCategory === item ? 'active' : ''}}"
        data-category="{{item}}"
        bindtap="onCategoryTap"
      >
        {{item}}
      </view>
    </view>
  </scroll-view>

  <view class="cart-bar" bindtap="goToCart">
    <text>Cart ({{cartCount}})</text>
  </view>

  <view wx:if="{{loading}}" class="loading">Loading products...</view>

  <view wx:elif="{{filteredProducts.length === 0}}" class="loading">No products found</view>

  <view wx:else class="product-grid">
    <view
      class="product-card card"
      wx:for="{{filteredProducts}}"
      wx:key="id"
    >
      <image class="product-image" src="{{item.images[0]}}" mode="aspectFill" bindtap="openProduct" data-id="{{item.id}}" />
      <view class="product-info" bindtap="openProduct" data-id="{{item.id}}">
        <text class="product-name">{{item.name}}</text>
        <text class="product-rating">★ {{item.rating}}</text>
        <text class="price">¥{{item.price}}</text>
      </view>
      <button class="add-btn" bindtap="addItemToCart" data-id="{{item.id}}">Add</button>
    </view>
  </view>
</view>
