.empty {
  padding: 40rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.cart-item {
  padding: 18rpx;
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
}

.meta {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.name {
  font-weight: 600;
}

.actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.qty-btn,
.remove {
  margin: 0;
  height: 50rpx;
  line-height: 50rpx;
  font-size: 24rpx;
  border-radius: 8rpx;
}

.qty-btn {
  width: 50rpx;
  background: #e5e7eb;
}

.remove {
  background: #fee2e2;
  color: #dc2626;
  padding: 0 14rpx;
}

.summary {
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.row {
  display: flex;
  justify-content: space-between;
}

.total {
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.bottom-actions {
  margin-top: 20rpx;
  display: flex;
  gap: 14rpx;
}

.bottom-actions button {
  flex: 1;
}

.primary {
  background: #2563eb;
  color: #fff;
}

.secondary {
  background: #e5e7eb;
  color: #111827;
}
