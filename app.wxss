page {
  background: #f6f8fb;
  color: #1f2937;
  font-size: 28rpx;
}

.container {
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 18rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
}

.price {
  color: #ef4444;
  font-size: 32rpx;
  font-weight: 700;
}

.primary-btn {
  background: #2563eb;
  color: #ffffff;
  border-radius: 14rpx;
}
